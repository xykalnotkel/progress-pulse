# ============================================================
# XySpace Blog — environment variables
# Copy to .env.local for local development, then fill values.
# Never commit .env.local or any real secret.
# ============================================================

# Set "true" to run the public site with demo data and no external services.
NEXT_PUBLIC_DEMO_MODE=true

# Canonical URL used by SEO metadata, sitemap and share links.
# Example: https://xyspace.xyc.my.id
NEXT_PUBLIC_SITE_URL=

# --- Supabase -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google account (email) allowed to use the admin control room (badge XyDev).
ADMIN_EMAIL=

# Optional: comma separated Google emails allowed to reply with badge XyTeam.
TEAM_EMAILS=

# Server-only HMAC secret for durable rate limits and anonymous deduplication.
# Generate independently with: openssl rand -hex 32
ABUSE_HASH_SECRET=

# Cloudflare Turnstile for anonymous comment verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudinary ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- AI publishing API -----------------------------------------
# Long random token given only to the AI agent / automation service.
# Generate with: openssl rand -hex 32
AI_INGEST_TOKEN=

# Optional: enable the draft_copy action (AI copy generation).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
